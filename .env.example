# Copy to .env and fill in what you need. All variables are optional.
# Real environment variables take precedence over this file.

# --- LLM providers (needed only for text -> deck generation; the MCP `create_presentation` tool needs none)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# TXT2PPTX_LLM_PROVIDER=anthropic        # default: first provider with a key
# OPENAI_MODEL=gpt-6-astra
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_MAX_TOKENS=16000
# LLM_TEMPERATURE=                        # unset = provider default (required by reasoning models)
# LLM_TIMEOUT_SECONDS=240
# EMBEDDING_MODEL=text-embedding-3-small  # reference-doc retrieval (needs OPENAI_API_KEY)

# --- Paths (relative paths are resolved against TXT2PPTX_HOME, default: current directory;
#     the MCP server defaults TXT2PPTX_HOME to ~/txt2pptx)
# TXT2PPTX_HOME=.
# TXT2PPTX_OUTPUT_DIR=exports
# TXT2PPTX_CACHE_DIR=cache
# TXT2PPTX_LOG_DIR=logs
# TXT2PPTX_TEMPLATES_DIR=                 # extra *.json templates
# DOCS_PATH=data/python-pptx-documentation.pdf

# --- Behaviour
# LOG_LEVEL=INFO
# TXT2PPTX_MAX_INPUT_CHARS=120000
# TXT2PPTX_MAX_UPLOAD_MB=25
# TXT2PPTX_EXPORT_RETENTION_HOURS=72      # 0 = keep forever
# TXT2PPTX_ENABLE_CODE_EXECUTION=false    # experimental: runs LLM-written code (sandboxed subprocess)

# --- Web UI
# TXT2PPTX_SERVER_NAME=127.0.0.1          # use 0.0.0.0 to expose on the network (then set auth!)
# TXT2PPTX_SERVER_PORT=7860
# TXT2PPTX_UI_AUTH=user:password

# --- MCP server (streamable-http transport)
# TXT2PPTX_MCP_HOST=127.0.0.1
# TXT2PPTX_MCP_PORT=8000
# TXT2PPTX_MCP_ALLOWED_HOSTS=["decks.example.com:*"]
